{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "Bash(grep -n \"pub fn FileUploader\\\\|on_upload_success\" src/common/components/file_uploader/*.rs)",
      "Bash(xcode-select -p)",
      "Bash(xcrun simctl *)",
      "Bash(curl -s -o /dev/null -w \"dev.ratel.foundation: %{http_code}\\\\n\" https://dev.ratel.foundation/)",
      "Bash(pkill -f \"dx serve\")",
      "Bash(lsof -ti:8100)",
      "Bash(xargs kill -9)",
      "Bash(echo \"stopped. 8100: $\\(lsof -ti:8100 2>&1 && echo busy || echo free\\)\")"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cat $CLAUDE_PROJECT_DIR/.claude/rules/conventions/anti-patterns.md"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "dioxus-knowledge-patch@nevaberry-plugins": true
  }
}
